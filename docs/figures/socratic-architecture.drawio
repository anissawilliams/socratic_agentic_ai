<mxCell id="control" value="&lt;font style=&quot;font-size: 28px&quot;&gt;&lt;b&gt;Control condition&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Direct chat&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;One completion each turn.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;The learner chooses the topic.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;No phase, evaluator, or router.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Same scenario, model, temperature,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;and timer as the Socratic arm.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Opens with a neutral invitation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1A1A1A;strokeWidth=1.5;arcSize=3;fontFamily=Helvetica;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=#F4F4F4;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="420" height="668" as="geometry"/></mxCell>
