
# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="socratic-tutor-app"


# OpenAI
OPENAI_API_KEY=your_openai_api_key
# Pin a dated snapshot, not the floating gpt-4o-mini alias, so the model stays
# fixed for the duration of data collection.
LLM_MODEL=gpt-4o-mini-2024-07-18
LLM_TEMPERATURE=0.7
LLM_PROMPT_VERSION=1.0.0

# Supabase - RLS enabled so we need to use the secret key
SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_anon_key
